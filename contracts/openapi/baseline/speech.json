{
  "components": {
    "schemas": {
      "AudioFormat": {
        "description": "Formats accepted or produced by the configured provider.",
        "enum": [
          "wav",
          "mp3",
          "m4a",
          "ogg",
          "webm"
        ],
        "title": "AudioFormat",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SynthesisRequest": {
        "additionalProperties": false,
        "description": "Text and voice for TTS. The text is not stored.",
        "properties": {
          "format": {
            "$ref": "#/components/schemas/AudioFormat",
            "default": "mp3"
          },
          "locale": {
            "anyOf": [
              {
                "maxLength": 16,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "voice_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Voice Id",
            "type": "string"
          }
        },
        "required": [
          "text",
          "voice_id"
        ],
        "title": "SynthesisRequest",
        "type": "object"
      },
      "TranscriptionResponse": {
        "additionalProperties": false,
        "description": "Transcription metadata and text owned by the phone after the response.",
        "properties": {
          "duration_seconds": {
            "minimum": 0.0,
            "title": "Duration Seconds",
            "type": "number"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "provider_format": {
            "$ref": "#/components/schemas/AudioFormat"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "text",
          "duration_seconds",
          "provider_format"
        ],
        "title": "TranscriptionResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Voice": {
        "additionalProperties": false,
        "description": "One provider-authorized voice; cloning is not supported.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Voice",
        "type": "object"
      },
      "VoiceCatalog": {
        "additionalProperties": false,
        "description": "Voices the account may select.",
        "properties": {
          "voices": {
            "items": {
              "$ref": "#/components/schemas/Voice"
            },
            "title": "Voices",
            "type": "array"
          }
        },
        "required": [
          "voices"
        ],
        "title": "VoiceCatalog",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Diary Speech API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Process liveness.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "description": "Require identity authorization for readiness.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/metrics": {
      "get": {
        "description": "Internal metrics.",
        "operationId": "metrics_metrics_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-metrics-token",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Metrics-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Metrics"
      }
    },
    "/v1/speech/syntheses": {
      "post": {
        "description": "Stream synthesized audio; the text is not stored.",
        "operationId": "synthesize_v1_speech_syntheses_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "default": "",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Synthesize",
        "tags": [
          "speech"
        ]
      }
    },
    "/v1/speech/transcriptions": {
      "post": {
        "description": "Transcribe audio without persisting or logging its bytes.",
        "operationId": "transcribe_v1_speech_transcriptions_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "default": "",
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Audio-Format",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Audio-Format"
            }
          },
          {
            "in": "header",
            "name": "X-Audio-Language",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Audio-Language"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Transcribe",
        "tags": [
          "speech"
        ]
      }
    },
    "/v1/speech/voices": {
      "get": {
        "description": "Return the provider-authorized catalog.",
        "operationId": "voices_v1_speech_voices_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceCatalog"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Voices",
        "tags": [
          "speech"
        ]
      }
    }
  }
}
