{
  "components": {
    "schemas": {
      "ContextCreate": {
        "additionalProperties": false,
        "description": "Request to create an authorized copy.",
        "properties": {
          "client_context_id": {
            "format": "uuid",
            "title": "Client Context Id",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ContextPurpose"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/SelectedRecord"
            },
            "maxItems": 50,
            "title": "Records",
            "type": "array"
          },
          "retention_policy": {
            "$ref": "#/components/schemas/RetentionPolicy"
          }
        },
        "required": [
          "client_context_id",
          "purpose",
          "retention_policy"
        ],
        "title": "ContextCreate",
        "type": "object"
      },
      "ContextPurpose": {
        "description": "Allowed reasons to create a copy.",
        "enum": [
          "transcribe",
          "conversation",
          "recall",
          "organize",
          "timeline",
          "summarize"
        ],
        "title": "ContextPurpose",
        "type": "string"
      },
      "DeletionState": {
        "description": "Durable purge lifecycle.",
        "enum": [
          "PENDING",
          "RUNNING",
          "COMPLETED",
          "FAILED_RETRYABLE"
        ],
        "title": "DeletionState",
        "type": "string"
      },
      "DeletionView": {
        "additionalProperties": false,
        "description": "Deletion status without the deleted content.",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "deletion_id": {
            "format": "uuid",
            "title": "Deletion Id",
            "type": "string"
          },
          "purge_deadline": {
            "format": "date-time",
            "title": "Purge Deadline",
            "type": "string"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/DeletionState"
          }
        },
        "required": [
          "deletion_id",
          "state",
          "requested_at",
          "purge_deadline",
          "completed_at"
        ],
        "title": "DeletionView",
        "type": "object"
      },
      "EventPrecision": {
        "description": "How precisely the user dated the event.",
        "enum": [
          "unknown",
          "date",
          "datetime",
          "approximate"
        ],
        "title": "EventPrecision",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InternalContextRecords": {
        "additionalProperties": false,
        "description": "Trusted-service view of the records inside one ready copy.",
        "properties": {
          "content_sha256": {
            "title": "Content Sha256",
            "type": "string"
          },
          "context_id": {
            "format": "uuid",
            "title": "Context Id",
            "type": "string"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/SelectedRecord"
            },
            "title": "Records",
            "type": "array"
          }
        },
        "required": [
          "context_id",
          "content_sha256",
          "records"
        ],
        "title": "InternalContextRecords",
        "type": "object"
      },
      "RetentionPolicy": {
        "description": "Explicit retention choice; there is no silent default.",
        "enum": [
          "delete_after_processing",
          "keep_until_deleted"
        ],
        "title": "RetentionPolicy",
        "type": "string"
      },
      "RetentionUpdate": {
        "additionalProperties": false,
        "description": "Explicit retention change; requires `If-Match` with the current revision.",
        "properties": {
          "retention_policy": {
            "$ref": "#/components/schemas/RetentionPolicy"
          }
        },
        "required": [
          "retention_policy"
        ],
        "title": "RetentionUpdate",
        "type": "object"
      },
      "SelectedRecord": {
        "additionalProperties": false,
        "description": "A record the user explicitly selected, with its local text.",
        "properties": {
          "base_local_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Local Version Id"
          },
          "content_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Sha256",
            "type": "string"
          },
          "event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event At"
          },
          "event_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Date"
          },
          "event_description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Description"
          },
          "event_precision": {
            "$ref": "#/components/schemas/EventPrecision"
          },
          "local_record_id": {
            "format": "uuid",
            "title": "Local Record Id",
            "type": "string"
          },
          "local_version_id": {
            "format": "uuid",
            "title": "Local Version Id",
            "type": "string"
          },
          "local_version_number": {
            "minimum": 1.0,
            "title": "Local Version Number",
            "type": "integer"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "text": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "timezone": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "local_record_id",
          "local_version_id",
          "content_sha256",
          "local_version_number",
          "base_local_version_id",
          "text",
          "recorded_at",
          "event_at",
          "event_date",
          "event_precision",
          "timezone"
        ],
        "title": "SelectedRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Diary Exchange API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Process liveness without dependency checks.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "description": "Require PostgreSQL; storage is checked by the upload flow.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/internal/contexts/{context_id}": {
      "get": {
        "description": "Decrypt one owner's ready copy for conversation or speech.",
        "operationId": "context_records_internal_contexts__context_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Context Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "owner_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Owner Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Internal-Service",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Internal-Service",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Internal-Token",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Internal-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalContextRecords"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Context Records",
        "tags": [
          "internal"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Expose internal metrics only with a configured token.",
        "operationId": "metrics_metrics_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-metrics-token",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Metrics-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Metrics"
      }
    },
    "/v1/exchange/contexts": {
      "post": {
        "description": "Create an authorized copy once per `client_context_id`.",
        "operationId": "create_v1_exchange_contexts_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create",
        "tags": [
          "exchange"
        ]
      }
    },
    "/v1/exchange/contexts/{context_id}": {
      "delete": {
        "description": "Request durable deletion of the copy.",
        "operationId": "delete_v1_exchange_contexts__context_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Context Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete",
        "tags": [
          "exchange"
        ]
      },
      "get": {
        "description": "Return the owner's manifest without texts.",
        "operationId": "read_v1_exchange_contexts__context_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Context Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read",
        "tags": [
          "exchange"
        ]
      }
    },
    "/v1/exchange/contexts/{context_id}/retention": {
      "patch": {
        "description": "Change only the retention policy, guarded by `If-Match`.",
        "operationId": "retention_v1_exchange_contexts__context_id__retention_patch",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Context Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetentionUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retention",
        "tags": [
          "exchange"
        ]
      }
    },
    "/v1/exchange/contexts/{context_id}/seal": {
      "post": {
        "description": "Seal a draft copy; repeating the call is idempotent.",
        "operationId": "seal_v1_exchange_contexts__context_id__seal_post",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Context Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Seal",
        "tags": [
          "exchange"
        ]
      }
    },
    "/v1/exchange/deletions/{deletion_id}": {
      "get": {
        "description": "Return the purge status of a deletion.",
        "operationId": "read_deletion_v1_exchange_deletions__deletion_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "deletion_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Deletion Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Source",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Session-Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Deletion",
        "tags": [
          "exchange"
        ]
      }
    }
  }
}
