# Copy to .env and adjust. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (identity, operations, outbox, notifications ledger)
DATABASE_URL=postgresql+asyncpg://diary:diary@localhost:55432/diary
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# MongoDB (sanitized operational logs only)
MONGO_URL=mongodb://diary:diary@localhost:57017
MONGO_DB=diary_logs
MONGO_LOG_BUFFER=1000

# Identity and session tokens
JWT_ISSUER=diary-api
JWT_AUDIENCE=diary-mobile
JWT_KEYS_DIR=keys/jwt
JWT_ACTIVE_KID=dev-1
ACCESS_TOKEN_TTL_SECONDS=600
SESSION_MAX_DAYS=30
REFRESH_TTL_DAYS=30
SOURCE_AUDIENCE=diary-mobile-source
SOURCE_ISSUER=diary-api
# base64url-encoded 32-byte key; generate with scripts/dev_keys.py
SOURCE_ENCRYPTION_KEY=REPLACE_ME
MCP_CONTEXT_KEY=REPLACE_ME
EMAIL_TOKEN_KEY=REPLACE_ME
IDEMPOTENCY_HMAC_KEY=REPLACE_ME
PUSH_TOKEN_KEY=REPLACE_ME
BILLING_TOKEN_KEY=REPLACE_ME

# Internal service authentication (JSON map of caller name to token)
IDENTITY_INTERNAL_SECRETS={"conversation":"dev-conversation-secret","speech":"dev-speech-secret","exchange":"dev-exchange-secret"}
IDENTITY_INTERNAL_URL=http://localhost:8001
CONVERSATION_INTERNAL_TOKEN=dev-conversation-secret
SPEECH_INTERNAL_TOKEN=dev-speech-secret
MCP_SERVICE_TOKEN=dev-mcp-secret
MCP_URL=http://localhost:8082/mcp

# AI provider (OpenAI-compatible). Leave empty to use deterministic test adapters.
OPENAI_API_KEY=
LLM_PROVIDER=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICES=alloy,verse,sage
TTS_MAX_CHARS=4000

# Billing: google_play in production, fake only in local/test
BILLING_PROVIDER=fake
GOOGLE_PLAY_PACKAGE_NAME=com.example.diary
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Push: fcm in production, dev logs a sanitized line
PUSH_PROVIDER=dev
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Android delta flags (production starts disabled until gates)
OIDC_ENABLED=false
OIDC_TRANSACTION_TTL_SECONDS=300
OIDC_ALLOWED_REDIRECT_URIS=["http://localhost:8080/auth/callback"]
# JSON map: provider -> discovery_url, client_id, client_secret (optional), scopes
OIDC_PROVIDERS={}
# OIDC_LINK_KEY=  # defaults to EMAIL_TOKEN_KEY
OIDC_LINK_TOKEN_TTL_SECONDS=300
ADS_ENABLED=false
REWARDED_ADS_ENABLED=false
AD_POLICY_VERSION=local-fixture-1
CONTEXT_EXCHANGE_ENABLED=false
ASYNC_TRANSCRIPTION_ENABLED=false

# Exchange and object storage (MinIO locally)
EXCHANGE_INTERNAL_URL=http://localhost:8080
EXCHANGE_SERVICE_TOKEN=dev-exchange-secret
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=diary
STORAGE_SECRET_KEY=diary-secret
STORAGE_BUCKET=diary-exchange
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
CONTEXT_MASTER_KEY=REPLACE_ME
CURSOR_HMAC_KEY=REPLACE_ME
SIGNED_URL_TTL_SECONDS=600

# Transactional email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@diary.local
SMTP_STARTTLS=false
EMAIL_LINK_BASE_URL=http://localhost:3000

# Maintenance
BACKUP_DIR=backups
BACKUP_ENCRYPTION_KEY=REPLACE_ME
BACKUP_RETENTION_DAYS=7
RETENTION_LOG_DAYS=7
RETENTION_RECEIPT_HOURS=24
RETENTION_NOTIFICATION_DAYS=30
RETENTION_SECURITY_DAYS=30
ACCOUNT_DELETION_GRACE_DAYS=30

# Per-operation limits
MAX_CONTEXT_BYTES=262144
MAX_CONTEXT_RECORDS=50
MAX_CONTEXT_CHARS=50000
MAX_MESSAGE_CHARS=8000
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=120
